<style>

/* =========================
   VARIABLES
========================= */

:root {
    --dark: #07151b;
    --dark2: #0d252d;
    --blue: #19a7b8;
    --blue-light: #7de1e8;
    --white: #ffffff;
    --cream: #f4f8f8;
    --text: #24343a;
    --muted: #6c7c81;
    --gold: #e9bd69;
    --radius: 24px;
    --shadow: 0 20px 60px rgba(0,0,0,.10);
}

/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    color: var(--text);
    background: var(--white);
    overflow-x: hidden;
}

img {
    width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
textarea,
select {
    font-family: inherit;
}

/* =========================
   GENERAL
========================= */

.container {
    width: min(1160px, 92%);
    margin: auto;
}

.section {
    padding: 100px 0;
}

.section-label {
    color: var(--blue);
    text-transform: uppercase;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.section-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.05;
    color: var(--dark);
    margin-bottom: 20px;
}

.section-text {
    color: var(--muted);
    line-height: 1.8;
    max-width: 650px;
}

/* =========================
   BUTTONS
========================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 23px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    font-weight: 700;
    transition: .3s ease;
}

.btn-primary {
    background: var(--blue);
    color: white;
    box-shadow: 0 12px 30px rgba(25,167,184,.25);
}

.btn-primary:hover {
    transform: translateY(-3px);
    background: #118f9f;
}

.btn-light {
    background: white;
    color: var(--dark);
}

.btn-light:hover {
    transform: translateY(-3px);
}

/* =========================
   HEADER
========================= */

header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    padding: 18px 0;
    transition: .3s;
}

header.scrolled {
    background: rgba(7,21,27,.94);
    backdrop-filter: blur(15px);
    padding: 12px 0;
}

.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-weight: 800;
    font-size: 21px;
}

.logo-icon {
    width: 40px;
    height: 40px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--blue-light), var(--blue));
    color: var(--dark);
    font-size: 20px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    color: white;
    font-size: 14px;
}

.nav-links a {
    opacity: .85;
    transition: .2s;
}

.nav-links a:hover {
    opacity: 1;
    color: var(--blue-light);
}

.menu-btn {
    display: none;
    background: transparent;
    border: 0;
    color: white;
    font-size: 28px;
    cursor: pointer;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(4,15,20,.88) 0%, rgba(4,15,20,.60) 45%, rgba(4,15,20,.10) 100%),
        url("https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=2000&q=85")
        center/cover;
}

.hero-content {
    color: white;
    max-width: 720px;
    padding-top: 70px;
}

.hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 50px;
    background: rgba(255,255,255,.12);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,.15);
    font-size: 13px;
    margin-bottom: 22px;
}

.hero h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(48px, 7vw, 82px);
    line-height: .98;
    margin-bottom: 24px;
}

.hero h1 span {
    color: var(--blue-light);
}

.hero p {
    max-width: 580px;
    color: rgba(255,255,255,.78);
    line-height: 1.8;
    font-size: 17px;
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.hero-stats {
    display: flex;
    gap: 35px;
    margin-top: 55px;
}

.stat strong {
    font-size: 28px;
    display: block;
}

.stat span {
    color: rgba(255,255,255,.65);
    font-size: 13px;
}

/* =========================
   TRUST BAR
========================= */

.trust {
    background: var(--dark);
    color: white;
    padding: 25px 0;
}

.trust-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
}

.trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    font-size: 14px;
}

.trust-icon {
    font-size: 23px;
}

/* =========================
   SERVICES
========================= */

.services {
    background: var(--cream);
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 22px;
    margin-top: 50px;
}

.service-card {
    background: white;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,.06);
    transition: .35s;
}

.service-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow);
}

.service-image {
    height: 240px;
    overflow: hidden;
}

.service-image img {
    height: 100%;
    object-fit: cover;
    transition: .5s;
}

.service-card:hover .service-image img {
    transform: scale(1.07);
}

.service-body {
    padding: 27px;
}

.service-icon {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    background: #e8f8f9;
    border-radius: 15px;
    font-size: 24px;
    margin-bottom: 18px;
}

.service-body h3 {
    color: var(--dark);
    margin-bottom: 10px;
    font-size: 21px;
}

.service-body p {
    color: var(--muted);
    line-height: 1.7;
    font-size: 14px;
}

/* =========================
   FEATURE
========================= */

.feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.feature-image {
    position: relative;
}

.feature-image img {
    border-radius: 30px;
    height: 600px;
    object-fit: cover;
}

.floating-card {
    position: absolute;
    right: -30px;
    bottom: 35px;
    background: white;
    padding: 20px;
    border-radius: 20px;
    box-shadow: var(--shadow);
    width: 210px;
}

.floating-card strong {
    font-size: 28px;
    color: var(--blue);
}

.floating-card p {
    font-size: 13px;
    color: var(--muted);
}

.check-list {
    list-style: none;
    margin: 30px 0;
}

.check-list li {
    display: flex;
    gap: 12px;
    margin-bottom: 17px;
    color: var(--text);
}

.check {
    width: 23px;
    height: 23px;
    flex: 0 0 23px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #ddf6f7;
    color: var(--blue);
    font-size: 12px;
}

/* =========================
   GALLERY
========================= */

.gallery {
    background: var(--dark);
}

.gallery .section-title {
    color: white;
}

.gallery .section-text {
    color: rgba(255,255,255,.65);
}

.gallery-grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr .8fr;
    grid-template-rows: 260px 260px;
    gap: 14px;
    margin-top: 50px;
}

.gallery-item {
    border-radius: 20px;
    overflow: hidden;
}

.gallery-item:first-child {
    grid-row: 1 / 3;
}

.gallery-item img {
    height: 100%;
    object-fit: cover;
    transition: .5s;
}

.gallery-item:hover img {
    transform: scale(1.06);
}

/* =========================
   PRICING
========================= */

.pricing {
    background: var(--cream);
}

.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
    margin-top: 50px;
}

.price-card {
    background: white;
    border-radius: 25px;
    padding: 35px;
    border: 1px solid #e6eeee;
    position: relative;
}

.price-card.featured {
    background: var(--dark);
    color: white;
    transform: translateY(-12px);
}

.badge {
    position: absolute;
    right: 20px;
    top: 20px;
    background: var(--gold);
    color: var(--dark);
    font-size: 11px;
    font-weight: 800;
    padding: 7px 11px;
    border-radius: 50px;
}

.price-card h3 {
    margin-bottom: 15px;
    font-size: 21px;
}

.price {
    font-size: 43px;
    font-weight: 800;
    margin-bottom: 25px;
}

.price small {
    font-size: 13px;
    color: var(--muted);
}

.price-card.featured .price small {
    color: rgba(255,255,255,.6);
}

.price-list {
    list-style: none;
    margin-bottom: 30px;
}

.price-list li {
    padding: 10px 0;
    color: var(--muted);
    font-size: 14px;
}

.price-card.featured .price-list li {
    color: rgba(255,255,255,.7);
}

/* =========================
   REVIEWS
========================= */

.reviews-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
    margin-top: 50px;
}

.review {
    padding: 30px;
    border: 1px solid #e8eeee;
    border-radius: 22px;
}

.stars {
    color: var(--gold);
    margin-bottom: 17px;
}

.review p {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 20px;
}

.reviewer {
    display: flex;
    align-items: center;
    gap: 12px;
}

.avatar {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: linear-gradient(135deg,var(--blue),var(--blue-light));
    display: grid;
    place-items: center;
    color: white;
    font-weight: 800;
}

.reviewer small {
    color: var(--muted);
}

/* =========================
   CONTACT
========================= */

.contact {
    background:
        linear-gradient(120deg, rgba(7,21,27,.97), rgba(10,48,56,.93)),
        url("https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?auto=format&fit=crop&w=1800&q=80")
        center/cover;
    color: white;
}

.contact-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 70px;
    align-items: center;
}

.contact .section-title {
    color: white;
}

.contact .section-text {
    color: rgba(255,255,255,.68);
}

.contact-info {
    margin-top: 30px;
}

.contact-line {
    display: flex;
    gap: 15px;
    align-items: center;
    margin: 18px 0;
}

.contact-line span:first-child {
    width: 43px;
    height: 43px;
    border-radius: 14px;
    background: rgba(255,255,255,.1);
    display: grid;
    place-items: center;
}

.contact-form {
    background: white;
    color: var(--text);
    padding: 35px;
    border-radius: 28px;
    box-shadow: var(--shadow);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 7px;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    border: 1px solid #dfe8e9;
    border-radius: 13px;
    padding: 14px;
    outline: none;
    background: #f8fbfb;
}

.form-group textarea {
    min-height: 120px;
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: var(--blue);
}

/* =========================
   FOOTER
========================= */

footer {
    background: #041015;
    color: white;
    padding: 55px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 50px;
    padding-bottom: 40px;
}

footer h4 {
    margin-bottom: 18px;
}

footer p,
footer a {
    color: rgba(255,255,255,.58);
    font-size: 14px;
    line-height: 2;
}

.footer-bottom {
    border-top: 1px solid rgba(255,255,255,.1);
    padding-top: 20px;
    color: rgba(255,255,255,.4);
    font-size: 12px;
    display: flex;
    justify-content: space-between;
}

/* =========================
   LOGIN MODAL
========================= */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.65);
    backdrop-filter: blur(8px);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal.active {
    display: flex;
}

.login-box {
    width: min(430px,100%);
    background: white;
    border-radius: 28px;
    padding: 35px;
    position: relative;
    animation: popup .3s ease;
}

@keyframes popup {
    from {
        transform: scale(.9);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.close-modal {
    position: absolute;
    right: 20px;
    top: 18px;
    border: none;
    background: #eef3f3;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
}

.login-logo {
    margin-bottom: 25px;
}

.login-box h2 {
    font-family: "Playfair Display", serif;
    font-size: 34px;
    color: var(--dark);
    margin-bottom: 8px;
}

.login-box > p {
    color: var(--muted);
    margin-bottom: 25px;
    font-size: 14px;
}

.login-message {
    margin-top: 15px;
    font-size: 13px;
    text-align: center;
    color: var(--blue);
}

/* =========================
   TOAST
========================= */

.toast {
    position: fixed;
    right: 20px;
    bottom: 20px;
    background: var(--dark);
    color: white;
    padding: 16px 20px;
    border-radius: 15px;
    z-index: 5000;
    transform: translateY(120px);
    opacity: 0;
    transition: .3s;
}

.toast.show {
    transform: translateY(0);
    opacity: 1;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 850px) {

    .nav-links {
        position: absolute;
        top: 75px;
        left: 4%;
        width: 92%;
        background: var(--dark);
        padding: 20px;
        border-radius: 20px;
        flex-direction: column;
        align-items: flex-start;
        display: none;
    }

    .nav-links.active {
        display: flex;
    }

    .menu-btn {
        display: block;
    }

    .trust-grid,
    .services-grid,
    .pricing-grid,
    .reviews-grid {
        grid-template-columns: 1fr 1fr;
    }

    .feature,
    .contact-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .feature-image img {
        height: 450px;
    }

    .floating-card {
        right: 15px;
    }

    .gallery-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 250px 250px 250px;
    }

    .gallery-item:first-child {
        grid-row: auto;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 560px) {

    .section {
        padding: 75px 0;
    }

    .hero {
        min-height: 800px;
    }

    .hero h1 {
        font-size: 50px;
    }

    .hero p {
        font-size: 15px;
    }

    .hero-stats {
        gap: 20px;
    }

    .stat strong {
        font-size: 22px;
    }

    .trust-grid,
    .services-grid,
    .pricing-grid,
    .reviews-grid,
    .footer-grid {
        grid-template-columns: 1fr;
    }

    .price-card.featured {
        transform: none;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: repeat(5,220px);
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .contact-form {
        padding: 24px;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 10px;
    }
}

</style>
</head>

